{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ExternalApi": {
    "BaseUrl": "https://jsonplaceholder.typicode.com/"
  },
  "AllowedHosts": "*"
}
